# Optional: supply your Firebase web config here instead of editing src/firebase.js.
# Copy this file to `.env.local` (which is git-ignored) and fill in the values
# from Firebase console → Project settings → Your apps → SDK setup and config.
# When VITE_FIREBASE_API_KEY is set, these values win over the inline config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
